# Copy this file to `.env` and fill in real values, or export these as
# real environment variables on whatever platform you deploy to.
# This app reads them with plain os.Getenv — if you use a .env file you'll
# need to load it yourself (e.g. `export $(cat .env | xargs)` before
# running, or a tool like `direnv`/`godotenv` in front of the binary).

# The public URL this site will be reachable at once deployed.
# Used for canonical links, Open Graph tags, JSON-LD, robots.txt and
# sitemap.xml. No trailing slash.
SITE_URL=https://your-domain.example

# Port the Go server listens on (most hosts set this for you automatically).
PORT=8080

# --- Email sending (contact form) ---
# The account the enquiry email is sent FROM. If using Gmail's SMTP relay,
# this must be a real Gmail address with an "App Password" generated at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be turned on). Do NOT use your normal Gmail password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-character-app-password

# Who receives the enquiry emails. Defaults to mcmoandrew@gmail.com if unset.
CONTACT_TO_EMAIL=mcmoandrew@gmail.com
